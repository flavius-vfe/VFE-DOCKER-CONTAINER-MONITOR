<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "vfe-unraid-backup-001">
<!ENTITY title       "VFE UNRAID BACKUP 001">
<!ENTITY author      "VFE Flavius">
<!ENTITY version     "2026.07.30">
<!ENTITY launch      "Settings/VFEUnraidBackup001">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/flavius-vfe/VFE-UNRAID-BACKUP-001/main/vfe-unraid-backup-001.plg">
<!ENTITY supportURL  "https://github.com/flavius-vfe/VFE-UNRAID-BACKUP-001/issues">
<!ENTITY projectURL  "https://github.com/flavius-vfe/VFE-UNRAID-BACKUP-001">
<!ENTITY readmeURL   "https://github.com/flavius-vfe/VFE-UNRAID-BACKUP-001#readme">
<!ENTITY pluginLOC   "/boot/config/plugins/vfe-unraid-backup-001">
<!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/vfe-unraid-backup-001">
]>
<PLUGIN name="&name;" Title="&title;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&supportURL;" project="&projectURL;" readme="&readmeURL;" min="6.12.0">
<DESCRIPTION><![CDATA[
Backs up and restores Docker containers, appdata, volumes, templates, and network metadata on Unraid.
]]></DESCRIPTION>
<CHANGES><![CDATA[
### 2026.07.30
- Standardized the plugin name and short description.
- Removed the WebGUI entry from the Unraid Settings menu while retaining launch access from Installed Plugins.
- Added GitHub update metadata, Community Applications assets, publication icons, and clean removal handling.
- Product release remains 001; backup format remains _002.
]]></CHANGES>

<FILE Run="/bin/bash" Method="update">
<INLINE><![CDATA[
rm -f /usr/local/emhttp/plugins/dynamix/images/vfe-unraid-backup-001.png
rm -f /boot/config/plugins/images/vfe-unraid-backup-001.png
exit 0
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
mkdir -p "/boot/config/plugins/vfe-unraid-backup-001"
exit 0
]]></INLINE>
</FILE>

