<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -u
mkdir -p "/boot/config/plugins/vfe-unraid-backup-001" "/boot/config/plugins/vfe-unraid-backup-001/hooks"
if [ ! -f "/boot/config/plugins/vfe-unraid-backup-001/vfe-unraid-backup-001.cfg" ]; then
  cp "/usr/local/emhttp/plugins/vfe-unraid-backup-001/default.cfg" "/boot/config/plugins/vfe-unraid-backup-001/vfe-unraid-backup-001.cfg"
fi
chmod 600 "/boot/config/plugins/vfe-unraid-backup-001/vfe-unraid-backup-001.cfg"
chmod 700 "/boot/config/plugins/vfe-unraid-backup-001/hooks"
chmod 755 "/usr/local/emhttp/plugins/vfe-unraid-backup-001/scripts/vfe-unraid-backup-001.sh"
chmod 755 "/usr/local/emhttp/plugins/vfe-unraid-backup-001"/php/*-cli.php
mkdir -p /var/run/vfe-unraid-backup-001 /var/log/vfe-unraid-backup-001
: > /var/log/vfe-unraid-backup-001/current.log
chmod 700 /var/log/vfe-unraid-backup-001
chmod 600 /var/log/vfe-unraid-backup-001/current.log
mkdir -p /usr/local/emhttp/plugins/dynamix/images /boot/config/plugins/images
cp -f "/usr/local/emhttp/plugins/vfe-unraid-backup-001/images/vfe-unraid-backup-001.png" /usr/local/emhttp/plugins/dynamix/images/vfe-unraid-backup-001.png
cp -f "/usr/local/emhttp/plugins/vfe-unraid-backup-001/images/vfe-unraid-backup-001.png" /boot/config/plugins/images/vfe-unraid-backup-001.png
/usr/bin/php "/usr/local/emhttp/plugins/vfe-unraid-backup-001/php/schedule-cli.php" apply || true
if [ -d /usr/local/emhttp/plugins/backup-unraid ]; then
  printf '%s\n' 'WARNING: A predecessor backup-unraid plugin is installed. Disable its schedule or uninstall it before running this plugin.'
fi
printf '%s\n' 'VFE UNRAID BACKUP 001 installed. Launch it from Plugins -> Installed Plugins.'
exit 0
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set +e
rm -f "/boot/config/plugins/vfe-unraid-backup-001/vfe-unraid-backup-001.cron"
/usr/local/sbin/update_cron >/dev/null 2>&1 || true
removepkg vfe-unraid-backup-001 >/dev/null 2>&1 || true
rm -rf "/usr/local/emhttp/plugins/vfe-unraid-backup-001"
rm -rf /var/run/vfe-unraid-backup-001
rm -rf /var/log/vfe-unraid-backup-001
rm -f /usr/local/emhttp/plugins/dynamix/images/vfe-unraid-backup-001.png
rm -f /boot/config/plugins/images/vfe-unraid-backup-001.png
rm -f "/boot/config/plugins/vfe-unraid-backup-001"/vfe-unraid-backup-001-*.txz
printf '%s\n' 'VFE UNRAID BACKUP 001 removed. Persistent settings, hooks, and rollback inventory were retained.'
exit 0
]]></INLINE>
</FILE>
</PLUGIN>
