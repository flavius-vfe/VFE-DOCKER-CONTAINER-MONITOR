Menu="Utilities"
Title="VFE Docker Container Monitor"
Icon="vfe-docker-container-monitor.png"
Tag="plug"
---
<?php
$csrfToken = isset($var['csrf_token']) ? (string)$var['csrf_token'] : '';
if ($csrfToken === '') {
    foreach (['/usr/local/emhttp/state/var.ini', '/var/local/emhttp/var.ini'] as $stateFile) {
        $state = @parse_ini_file($stateFile);
        if (is_array($state) && !empty($state['csrf_token'])) {
            $csrfToken = (string)$state['csrf_token'];
            break;
        }
    }
}
?>
<link rel="stylesheet" href="/plugins/vfe.docker.container.monitor/assets/guardian.css?v=<?= @filemtime(__DIR__ . '/assets/guardian.css') ?: 0 ?>">
<script>
window.VFE_DOCKER_CONTAINER_MONITOR = {
  csrfTokenFallback: <?= json_encode($csrfToken, JSON_UNESCAPED_SLASHES) ?>,
  apiUrl: '/plugins/vfe.docker.container.monitor/include/api.php'
};
</script>

<div id="cg-app" class="cg-app">
  <input id="cg-csrf-token" type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrfToken, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
